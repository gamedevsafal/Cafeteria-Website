# ---- Divya Catering - server environment ----
# Copy this file to .env and fill in your values.  Never commit .env.

# MongoDB
# Local:  mongodb://127.0.0.1:27017/divya_catering
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/divya_catering
MONGO_URI=mongodb://127.0.0.1:27017/divya_catering

# Server
PORT=4000
NODE_ENV=development

# Public URL of this server (used in CORS + admin redirects)
CLIENT_URL=http://localhost:5173

# ---- Admin account created by `npm run seed` ----
ADMIN_EMAIL=admin@divyacatering.in
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-before-going-live
JWT_EXPIRES=7d

# ---- Stripe (leave blank for now; pay-on-pickup is used instead) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Business contact details baked into the seed data
BUSINESS_PHONE=+919876543210
BUSINESS_WHATSAPP=919876543210
BUSINESS_EMAIL=hello@divyacatering.in
